# Cross-compile on the builder architecture; no QEMU or privileged build needed.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder
RUN apk add --no-cache make
WORKDIR /src
ENV GOFLAGS=-p=2 GOMAXPROCS=2
SHELL ["nice", "-n", "10", "/bin/sh", "-c"]
COPY go.mod go.sum ./
RUN go mod download
# Explicit source allow-list keeps local tokens, environment files and evidence
# out of build layers even when the working directory contains private files.
COPY Makefile *.go ./
COPY internal/ ./internal/
COPY pkg/ ./pkg/
COPY proto/ ./proto/
COPY sdk/ ./sdk/
COPY scripts/ ./scripts/
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH make build BUILD_OUTPUT=/out/tunn

FROM --platform=$BUILDPLATFORM alpine:3.23 AS runtime-files
RUN apk add --no-cache ca-certificates && addgroup -g 10001 tunn && adduser -D -u 10001 -G tunn -h /home/tunn tunn

FROM scratch
COPY --from=runtime-files /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=runtime-files /etc/passwd /etc/passwd
COPY --from=runtime-files /etc/group /etc/group
COPY --from=runtime-files --chown=10001:10001 /home/tunn /home/tunn
COPY --from=builder /out/tunn /usr/local/bin/tunn
ENV HOME=/home/tunn TUNN_ENV=prod
WORKDIR /home/tunn
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/tunn"]
CMD ["--help"]
