[Unit]
Description=tunn AI host publisher (%i)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/lib/tunn-ai-hosts/runner.py %i --config %h/.config/tunn-ai-hosts/host.json
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
# Child output uses private rotating files (4 x ~1 MiB per service).
# Only brief supervisor failures reach journald, with a rate cap.
StandardOutput=null
StandardError=journal
LogRateLimitIntervalSec=60s
LogRateLimitBurst=10

[Install]
WantedBy=default.target
