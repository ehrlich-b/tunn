  "findings": [
    {
      "severity": "MEDIUM",
      "finding": "Early empty application refusal and ongoing 202 headers withheld until upload EOF.",
      "root": "waitStreamingHTTPResponseStart gated every unknown-length request on upload EOF or nonempty response data, regardless of response status.",
      "fix": "Release non-success and 202 acknowledgment heads; prefer an already available upload error before committing headers. Retain validation for empty final successes, including 200 and 204.",
      "regression": "TestHTTPFidelityHeadersBeforeUploadEOF",
      "cases": [
        "HTTP1/Accepted/relay",
        "HTTP1/Forbidden/relay",
        "HTTP2/Accepted/relay",
        "HTTP2/Forbidden/relay"
      ]
    },
    {
      "severity": "MEDIUM",
      "finding": "A completed HTTP/1 response could not reach successful EOF while upload input remained open.",
      "root": "Concurrent request Body.Read holds the HTTP/1 body lock; synchronous cleanup Body.Close waits for the lock and can drain unfinished input before the handler returns.",
      "fix": "Share one close across upload reader and both proxy cleanup owners; interrupt unfinished HTTP/1 reads with a read deadline, join the reader, close the connection after early response headers, and retain keep-alive for uploads consumed before headers. Override upstream keep-alive policy for unfinished input.",
      "regressions": [
        "TestHTTPFidelityCompletedResponseWithOpenWireUpload",
        "TestHTTPFidelityCompletedUploadKeepsConnection"
      ]
    }
  ],
