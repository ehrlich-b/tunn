app = "tunn"
primary_region = "iad"

[build]

[env]
  TUNN_ENV = "prod"
  TUNN_DOMAIN = "tunn.to"
  TUNN_LOGIN_NODE = "true"
  TUNN_ADDR = "0.0.0.0:443"
  TUNN_HTTP3_ADDR = "fly-global-services:443"
  TUNN_PUBLIC_ADDR = "tunn.to:443"
  TUNN_CERT_FILE = "/app/certs/fullchain.pem"
  TUNN_KEY_FILE = "/app/certs/privkey.pem"
  TUNN_SMTP_HOST = "smtp.resend.com"
  TUNN_SMTP_PORT = "587"
  TUNN_SMTP_FROM = "noreply@tunn.to"

[[services]]
  internal_port = 443
  protocol = "tcp"
  auto_stop_machines = false
  auto_start_machines = true

  # No handlers = TCP passthrough, tunn handles TLS
  [[services.ports]]
    port = 443

  [services.concurrency]
    hard_limit = 250
    soft_limit = 200
    type = "connections"

[[services]]
  internal_port = 443
  protocol = "udp"
  auto_stop_machines = false
  auto_start_machines = true

  [[services.ports]]
    port = 443

[mounts]
  source = "tunn_data"
  destination = "/data"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
