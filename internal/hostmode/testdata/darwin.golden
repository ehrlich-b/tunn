<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tunn.host</string>
  <key>ProgramArguments</key><array>
    <string>/opt/tunn/bin/tunn</string><string>--verbosity=error</string>
    <string>service</string><string>run</string><string>--config</string><string>/home/owner/.config/tunn/host.yaml</string>
  </array>
  <key>WorkingDirectory</key><string>/home/owner</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
