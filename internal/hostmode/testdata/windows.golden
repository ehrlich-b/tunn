<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <Triggers><LogonTrigger><Enabled>true</Enabled><UserId>OWNER\bryan</UserId></LogonTrigger></Triggers>
  <Principals><Principal id="Owner"><UserId>OWNER\bryan</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><StartWhenAvailable>true</StartWhenAvailable><ExecutionTimeLimit>PT0S</ExecutionTimeLimit><RestartOnFailure><Interval>PT1M</Interval><Count>999</Count></RestartOnFailure></Settings>
  <Actions Context="Owner"><Exec><Command>C:\Program Files\tunn\tunn.exe</Command><Arguments>--verbosity=error service run --config &#34;C:\Users\bryan\.config\tunn\host.yaml&#34;</Arguments><WorkingDirectory>C:\Users\bryan</WorkingDirectory></Exec></Actions>
</Task>
