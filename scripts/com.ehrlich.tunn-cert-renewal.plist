<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ehrlich.tunn-cert-renewal</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/ehrlich/repos/tunn/renew-certs.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/ehrlich/repos/tunn</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/ehrlich</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>StartInterval</key>
	<integer>86400</integer>

	<key>ThrottleInterval</key>
	<integer>3600</integer>

	<key>StandardOutPath</key>
	<string>/Users/ehrlich/.config/tunn/cert-renewal.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/ehrlich/.config/tunn/cert-renewal.log</string>
</dict>
</plist>
